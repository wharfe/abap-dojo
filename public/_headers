# Cloudflare Pages _headers — security headers applied at the edge.
# The main security defense for code execution is the sandboxed iframe in
# ExecutionSandbox.tsx (sandbox="allow-scripts" with no allow-same-origin,
# opaque origin). These headers are defense-in-depth.
#
# connect-src uses https://*.google-analytics.com rather than the bare
# www.google-analytics.com host: GA4 routes some regions (notably the EU, a core
# ABAP market) to region1.google-analytics.com, and a bare host would block
# those beacons silently — no console error the user would report, just missing
# data for those users.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
